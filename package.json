{
  "name": "smart-light-demo-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "スマート照明デモ版の API（Cloudflare Workers + Hono + D1）。フロントは frontend/ の静的書き出しを Workers Assets で配信する。",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply smart_light_demo_db --local"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.157.0"
  }
}
